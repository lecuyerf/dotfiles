# ─── Appearance (migrated from wezterm) ─────────────────────────────────────────
font-family = JetBrainsMonoNL Nerd Font
font-style = SemiBold
font-size = 18

theme = Catppuccin Macchiato

# Cursor (wezterm: BlinkingBlock + peach cursor on base background)
cursor-style = block
cursor-style-blink = true
cursor-color = #f5a97f
cursor-text = #24273a
# Stop shell integration / prompt from overriding the block cursor with a bar
shell-integration-features = no-cursor

# Window (wezterm: window_decorations = RESIZE, NeverPrompt close)
macos-titlebar-style = hidden
confirm-close-surface = false

# Mouse support
mouse-hide-while-typing = false

# Clipboard
clipboard-read = allow
clipboard-write = allow

## This is beta config autogenerated by LLM

# ─── Keybindings ──────────────────────────────────────────────────────────────
# ctrl+s is used as a "prefix" via Ghostty chord notation (ctrl+s>key)
# matching your tmux prefix C-s

# Reload config (was: prefix + r)
keybind = ctrl+s>r=reload_config

# Splits — mirror tmux prefix + " (vertical) and % (horizontal)
keybind = ctrl+s>shift+apostrophe=new_split:down
keybind = ctrl+s>shift+5=new_split:right

# Navigate splits — vim-tmux-navigator style (ctrl+h/j/k/l)
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# Tabs (tmux windows)
keybind = ctrl+s>c=new_tab
keybind = ctrl+s>n=next_tab
keybind = ctrl+s>p=previous_tab
keybind = ctrl+s>x=close_surface

# Jump to tab by number (mirrors tmux window index, base-1)
keybind = ctrl+s>1=goto_tab:1
keybind = ctrl+s>2=goto_tab:2
keybind = ctrl+s>3=goto_tab:3
keybind = ctrl+s>4=goto_tab:4
keybind = ctrl+s>5=goto_tab:5
keybind = ctrl+s>6=goto_tab:6
keybind = ctrl+s>7=goto_tab:7
keybind = ctrl+s>8=goto_tab:8
keybind = ctrl+s>9=goto_tab:9

# Quick terminal toggle — closest equivalent to tmux popup terminal (prefix + t)
# Drops down a floating Ghostty terminal (configure quick-terminal-* options below)
keybind = ctrl+s>t=toggle_quick_terminal

# ─── Quick Terminal (popup terminal replacement) ───────────────────────────────
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-size = 90%, 90%
quick-terminal-animation-duration = 0.1

# ─── Unported tmux features (for reference) ───────────────────────────────────
# prefix+l → lazygit popup       → no Ghostty equivalent; run `lazygit` manually
# prefix+g → gerrit-dashboard    → no Ghostty equivalent
# prefix+i → interrupt-dashboard → no Ghostty equivalent
# prefix+y → claude popup session → no Ghostty equivalent (persistent sessions)
# Status bar (catppuccin modules: directory, meetings, date_time, session)
#   → Ghostty has a tab bar but no tmux-style status modules
